<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project_team_dashboard.TeamDashboardMemberCard">
        <t t-set="member" t-value="this.props.member"/>
        <t t-set="currentTask" t-value="member.current_task"/>
        <div class="o_team_dashboard_member card h-100 shadow-sm"
             t-att-class="{ 'border-danger border-2': currentTask and currentTask.is_overdue }"
             t-att-data-user-id="member.user_id or 'unassigned'">
            <div class="card-header bg-view d-flex flex-wrap align-items-center gap-2">
                <img t-if="member.user_avatar_url" class="o_team_dashboard_avatar o_avatar rounded-circle"
                     t-att-src="member.user_avatar_url" alt=""/>
                <span t-else="" class="o_team_dashboard_avatar rounded-circle bg-secondary d-flex align-items-center justify-content-center">
                    <i class="oi text-white" data-icon="person" role="img" aria-hidden="true"/>
                </span>
                <div class="flex-grow-1 min-w-0">
                    <h6 class="o_team_dashboard_member_name mb-0 text-truncate" t-out="member.user_name"/>
                    <small class="text-muted">
                        <t t-out="member.total_open_tasks"/> tasks ·
                        <t t-if="member.total_remaining_hours >= 0">
                            <t t-out="this.formatHours(member.total_remaining_hours)"/>h remaining
                        </t>
                        <span t-else="" class="text-danger fw-bold"><t t-out="this.formatHours(-member.total_remaining_hours)"/>h over estimate</span>
                    </small>
                    <div t-if="this.showsProjects() and member.project_names?.length" class="d-flex flex-wrap gap-1 mt-1">
                        <span t-foreach="member.project_names" t-as="projectName" t-key="projectName_index"
                              class="badge text-bg-light border fw-normal text-truncate mw-100" t-out="projectName"/>
                    </div>
                </div>
                <div class="text-end small">
                    <span class="o_team_dashboard_hours_period badge text-bg-light border" title="Hours logged in period">
                        <i class="oi me-1" data-icon="schedule" role="img" aria-hidden="true"/><t t-out="this.formatHours(member.hours_logged_period)"/>h
                    </span>
                    <div class="o_team_dashboard_hours_today text-muted" title="Hours logged today">
                        Today: <t t-out="this.formatHours(member.hours_logged_today)"/>h
                    </div>
                </div>
                <div t-if="member.user_id" class="d-flex flex-wrap justify-content-end gap-1 w-100">
                    <t t-if="this.props.mode === 'project'">
                        <button type="button" class="o_team_dashboard_member_backlog btn btn-sm btn-outline-info py-0"
                                title="Open the backlog of this member"
                                t-on-click="() => this.props.onOpenBacklog(member.user_id)">
                            <i class="oi me-1" data-icon="format_list_bulleted" role="img" aria-hidden="true"/>Backlog
                        </button>
                        <button type="button" class="o_team_dashboard_member_kanban btn btn-sm btn-outline-info py-0"
                                title="Open the kanban of this member"
                                t-on-click="() => this.props.onOpenKanban(member.user_id)">
                            <i class="oi me-1" data-icon="view_kanban" role="img" aria-hidden="true"/>Kanban
                        </button>
                    </t>
                    <button type="button" class="o_team_dashboard_member_closed btn btn-sm btn-outline-info py-0"
                            title="View the closed tasks of this member"
                            t-on-click="() => this.props.onOpenClosedTasks(member.user_id)">
                        <i class="oi me-1" data-icon="check_circle" role="img" aria-hidden="true"/>Closed
                    </button>
                </div>
            </div>

            <div class="card-body p-2">
                <div t-if="currentTask" class="o_team_dashboard_current_task mb-2">
                    <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                        <span class="badge text-bg-success">Current</span>
                        <small class="text-muted" t-out="currentTask.stage_name"/>
                        <span t-if="this.showsProjects() and currentTask.project_name"
                              class="badge text-bg-light text-primary border fw-normal" t-out="currentTask.project_name"/>
                    </div>
                    <a href="#" class="o_team_dashboard_task_link fw-bold text-decoration-none text-truncate d-block"
                       t-on-click.prevent="() => this.props.onOpenTask(currentTask.id)">
                        <i t-if="currentTask.is_subtask" class="oi text-info me-1" data-icon="subdirectory_arrow_right"
                           role="img" title="Sub-task" aria-label="Sub-task"/>
                        <t t-if="currentTask.key"><span class="text-muted" t-out="currentTask.key"/> </t>
                        <t t-out="currentTask.name"/>
                    </a>
                    <small t-if="currentTask.is_subtask and currentTask.parent_key" class="text-info d-block ps-3">
                        sub-task of <t t-out="currentTask.parent_key"/>
                    </small>
                    <t t-if="currentTask.planned_hours > 0">
                        <div class="progress mt-1" role="progressbar" aria-label="Allocated hours spent"
                             aria-valuemin="0" aria-valuemax="100"
                             t-att-aria-valuenow="this.progressBarWidth(currentTask)">
                            <div class="progress-bar" t-att-class="this.progressBarClass(currentTask)"
                                 t-attf-style="width: {{ this.progressBarWidth(currentTask) }}%"/>
                        </div>
                        <small class="o_team_dashboard_current_hours text-muted">
                            <t t-out="this.formatHours(currentTask.remaining_hours)"/>h remaining
                            / <t t-out="this.formatHours(currentTask.planned_hours)"/>h estimated
                        </small>
                    </t>
                    <div t-if="currentTask.planned_date_end">
                        <small class="o_team_dashboard_deadline" t-att-class="currentTask.is_overdue ? 'text-danger fw-bold' : 'text-muted'">
                            <i class="oi me-1" data-icon="calendar_today" role="img" aria-hidden="true"/>
                            Deadline: <t t-out="this.formatDay(currentTask.planned_date_end)"/>
                            <t t-if="currentTask.is_overdue"> (OVERDUE)</t>
                        </small>
                    </div>
                </div>
                <div t-else="" class="mb-2 text-muted fst-italic">No active task</div>

                <TeamDashboardTaskQueue t-if="member.queue?.length" title.translate="In Progress Queue"
                                        tasks="member.queue" isHighlighted="true"
                                        showProject="this.showsProjects()" onOpenTask="this.props.onOpenTask"/>
                <TeamDashboardTaskQueue t-if="member.backlog?.length" title.translate="Backlog"
                                        tasks="member.backlog"
                                        showProject="this.showsProjects()" onOpenTask="this.props.onOpenTask"/>
                <TeamDashboardTaskQueue t-if="member.other?.length" title.translate="Other"
                                        tasks="member.other"
                                        showProject="this.showsProjects()" onOpenTask="this.props.onOpenTask"/>
            </div>

            <div class="card-footer d-flex flex-wrap justify-content-between gap-2 small text-muted">
                <span class="o_team_dashboard_planned_hours">
                    <i class="oi me-1" data-icon="bar_chart" role="img" aria-hidden="true"/><t t-out="this.formatHours(member.total_planned_hours)"/>h estimated
                </span>
                <span t-if="member.estimated_completion" class="o_team_dashboard_eta"
                      title="Estimated completion based on work schedule and leaves">
                    <i class="oi me-1" data-icon="sports_score" role="img" aria-hidden="true"/>ETA: <strong t-out="this.formatDay(member.estimated_completion)"/>
                </span>
            </div>
        </div>
    </t>

    <t t-name="project_team_dashboard.TeamDashboardTaskQueue">
        <div class="o_team_dashboard_queue mb-1">
            <button type="button" class="o_team_dashboard_queue_toggle btn btn-sm btn-link text-decoration-none text-muted p-0"
                    t-att-aria-expanded="this.state.isOpen ? 'true' : 'false'"
                    t-on-click="() => this.toggle()">
                <i class="oi me-1" t-att-data-icon="this.state.isOpen ? 'expand_less' : 'expand_more'" role="img" aria-hidden="true"/>
                <span t-att-class="{ 'fw-bold': this.props.isHighlighted }" t-out="this.props.title"/> <span class="badge text-bg-secondary" t-out="this.props.tasks.length"/>
            </button>
            <ul t-if="this.state.isOpen" class="o_team_dashboard_queue_list list-group list-group-flush mt-1">
                <li t-foreach="this.props.tasks" t-as="task" t-key="task.id"
                    class="list-group-item d-flex flex-wrap align-items-center column-gap-2 px-0 py-1">
                    <a href="#" class="o_team_dashboard_task_link text-decoration-none text-truncate flex-grow-1 min-w-0"
                       t-on-click.prevent="() => this.props.onOpenTask(task.id)">
                        <i t-if="task.is_subtask" class="oi text-info me-1" data-icon="subdirectory_arrow_right"
                           role="img" title="Sub-task" aria-label="Sub-task"/>
                        <small t-if="task.is_subtask and task.parent_key" class="text-info me-1">(<t t-out="task.parent_key"/>)</small>
                        <t t-if="task.key"><small class="text-muted" t-out="task.key"/> </t>
                        <t t-out="task.name"/>
                    </a>
                    <small class="d-flex flex-wrap align-items-center gap-1 text-muted">
                        <span t-if="this.props.showProject and task.project_name"
                              class="badge text-bg-light text-primary border fw-normal" t-out="task.project_name"/>
                        <span class="o_team_dashboard_queue_hours badge text-bg-light border" title="Remaining hours">
                            <t t-out="this.formatHours(task.remaining_hours)"/>h
                        </span>
                        <span t-if="task.planned_date_end" class="badge text-bg-light border" title="Deadline">
                            <i class="oi me-1" data-icon="calendar_today" role="img" aria-hidden="true"/><t t-out="this.formatDay(task.planned_date_end)"/>
                        </span>
                    </small>
                </li>
            </ul>
        </div>
    </t>

</templates>
