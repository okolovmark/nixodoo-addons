<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_planned_dates" model="ir.ui.view">
        <field name="name">project.task.form.planned.dates.inherit.project_team_dashboard</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <label for="planned_date_start" string="Planned Dates" name="planned_dates" />
                <div class="o_row" name="planned_dates">
                    <field name="is_planned_from_subtasks" invisible="1" />
                    <field
                        name="planned_date_start"
                        widget="daterange"
                        nolabel="1"
                        class="oe_inline"
                        options="{'related_end_date': 'planned_date_end'}"
                        attrs="{'readonly': [('is_planned_from_subtasks', '=', True)]}"
                    />
                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow" />
                    <field
                        name="planned_date_end"
                        widget="daterange"
                        nolabel="1"
                        class="oe_inline"
                        options="{'related_start_date': 'planned_date_start'}"
                        attrs="{'readonly': [('is_planned_from_subtasks', '=', True)]}"
                    />
                </div>
            </xpath>
            <!-- The form and each sub-task row carry the plan their Deadline follows from one onchange to the next. -->
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="date_deadline_planned_end" invisible="1" />
                <field name="date_deadline_project_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='child_ids']/tree/field[@name='date_deadline']" position="after">
                <field name="date_deadline_planned_end" invisible="1" />
                <field name="date_deadline_project_id" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2_planned_dates" model="ir.ui.view">
        <field name="name">project.task.tree.planned.dates.inherit.project_team_dashboard</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="is_planned_from_subtasks" invisible="1" />
                <field
                    name="planned_date_start"
                    optional="hide"
                    attrs="{'readonly': [('is_planned_from_subtasks', '=', True)]}"
                />
                <field
                    name="planned_date_end"
                    optional="hide"
                    attrs="{'readonly': [('is_planned_from_subtasks', '=', True)]}"
                />
            </field>
        </field>
    </record>
</odoo>
