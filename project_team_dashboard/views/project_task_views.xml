<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_planned_dates" model="ir.ui.view">
        <field name="name">project.task.form.planned.dates.inherit.project_team_dashboard</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']" position="before">
                <field
                    name="planned_date_start"
                    string="Planned Dates"
                    widget="daterange"
                    options="{'end_date_field': 'planned_date_end'}"
                    readonly="is_planned_from_subtasks"
                />
                <field name="planned_date_end" invisible="1" readonly="is_planned_from_subtasks" />
            </xpath>
            <!-- The form and its sub-task and Blocked By lines carry the plan their Deadline follows from one onchange to the next. -->
            <xpath expr="//div[@id='date_deadline_and_recurring_task']/field[@name='date_deadline']" position="after">
                <field name="date_deadline_planned_end" invisible="1" />
                <field name="date_deadline_project_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='child_ids']/list/field[@name='date_deadline']" position="after">
                <field name="date_deadline_planned_end" column_invisible="True" />
                <field name="date_deadline_project_id" column_invisible="True" />
            </xpath>
            <xpath expr="//field[@name='depend_on_ids']/list/field[@name='date_deadline']" position="after">
                <field name="date_deadline_planned_end" column_invisible="True" />
                <field name="date_deadline_project_id" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2_planned_dates" model="ir.ui.view">
        <field name="name">project.task.list.planned.dates.inherit.project_team_dashboard</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="planned_date_start" optional="hide" readonly="is_planned_from_subtasks" />
                <field name="planned_date_end" optional="hide" readonly="is_planned_from_subtasks" />
            </field>
        </field>
    </record>
</odoo>
