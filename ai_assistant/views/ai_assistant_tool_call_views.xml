<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_assistant_tool_call_view_form" model="ir.ui.view">
        <field name="name">ai.assistant.tool.call.view.form</field>
        <field name="model">ai.assistant.tool.call</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="conversation_id"/>
                        </group>
                        <group>
                            <field name="tool"/>
                            <field name="model_name"/>
                            <field name="outcome" widget="badge" decoration-success="outcome == 'ok'" decoration-warning="outcome == 'denied'" decoration-danger="outcome == 'error'"/>
                            <field name="row_count"/>
                            <field name="latency_ms"/>
                        </group>
                    </group>
                    <group>
                        <field name="arguments"/>
                        <field name="documents" attrs="{'invisible': [('documents', '=', False)]}"/>
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_assistant_tool_call_view_tree" model="ir.ui.view">
        <field name="name">ai.assistant.tool.call.view.tree</field>
        <field name="model">ai.assistant.tool.call</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" decoration-warning="outcome == 'denied'" decoration-danger="outcome == 'error'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="outcome"/>
                <field name="row_count" optional="show"/>
                <field name="latency_ms" optional="show"/>
                <field name="conversation_id" optional="hide"/>
                <field name="arguments" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Phones open the kanban, desktops the list. -->
    <record id="ai_assistant_tool_call_view_kanban" model="ir.ui.view">
        <field name="name">ai.assistant.tool.call.view.kanban</field>
        <field name="model">ai.assistant.tool.call</field>
        <field name="arch" type="xml">
            <kanban create="false" class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="tool"/>
                                    </strong>
                                    <div><field name="model_name"/></div>
                                </div>
                                <field name="outcome" widget="badge" decoration-success="outcome == 'ok'" decoration-warning="outcome == 'denied'" decoration-danger="outcome == 'error'"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="create_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_assistant_tool_call_view_search" model="ir.ui.view">
        <field name="name">ai.assistant.tool.call.view.search</field>
        <field name="model">ai.assistant.tool.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="tool"/>
                <field name="conversation_id"/>
                <filter string="Denied" name="outcome_denied" domain="[('outcome', '=', 'denied')]"/>
                <filter string="Errors" name="outcome_error" domain="[('outcome', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_name'}"/>
                    <filter string="Outcome" name="group_outcome" context="{'group_by': 'outcome'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_assistant_tool_call_action" model="ir.actions.act_window">
        <field name="name">Tool Calls</field>
        <field name="res_model">ai.assistant.tool.call</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
