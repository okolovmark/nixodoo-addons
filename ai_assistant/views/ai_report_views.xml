<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_report_view_form" model="ir.ui.view">
        <field name="name">ai.report.view.form</field>
        <field name="model">ai.report</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_open" type="object" string="Open" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="data_date"/>
                            <field name="conclusions_date"/>
                            <field name="is_stale"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="conversation_id"/>
                            <field name="exchange_id"/>
                            <field name="shared_user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Share log" name="share_log">
                            <field name="share_log_ids">
                                <list>
                                    <field name="create_date" string="When"/>
                                    <field name="user_id"/>
                                    <field name="action" widget="badge" decoration-success="action == 'share'" decoration-muted="action == 'unshare'"/>
                                    <field name="target_user_id"/>
                                </list>
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex justify-content-between gap-2">
                                                <field name="target_user_id" class="fw-bold"/>
                                                <field name="action" widget="badge" decoration-success="action == 'share'" decoration-muted="action == 'unshare'"/>
                                            </div>
                                            <footer>
                                                <field name="user_id"/>
                                                <field name="create_date" class="ms-auto"/>
                                            </footer>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Specification" name="spec" groups="base.group_system">
                            <field name="spec"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_report_view_tree" model="ir.ui.view">
        <field name="name">ai.report.view.tree</field>
        <field name="model">ai.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="name"/>
                <field name="user_id"/>
                <field name="data_date"/>
                <field name="conclusions_date" optional="hide"/>
                <field name="shared_user_ids" widget="many2many_tags" optional="show"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Phones open the kanban, desktops the list. -->
    <record id="ai_report_view_kanban" model="ir.ui.view">
        <field name="name">ai.report.view.kanban</field>
        <field name="model">ai.report</field>
        <field name="arch" type="xml">
            <kanban create="false" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <footer>
                            <field name="user_id"/>
                            <field name="data_date" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_report_view_search" model="ir.ui.view">
        <field name="name">ai.report.view.search</field>
        <field name="model">ai.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="shared_user_ids"/>
                <filter string="Shared" name="shared" domain="[('shared_user_ids', '!=', False)]" groups="base.group_system"/>
                <group>
                    <filter string="Owner" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- A share log row outlives its report: its title stays with it. -->
    <record id="ai_report_share_log_view_tree" model="ir.ui.view">
        <field name="name">ai.report.share.log.view.tree</field>
        <field name="model">ai.report.share.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="When"/>
                <field name="report_name"/>
                <field name="report_id" optional="hide"/>
                <field name="user_id"/>
                <field name="action" widget="badge" decoration-success="action == 'share'" decoration-muted="action == 'unshare'"/>
                <field name="target_user_id"/>
            </list>
        </field>
    </record>

    <record id="ai_report_action" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">ai.report</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
