<?xml version="1.0" encoding="utf-8"?>
<!-- An AI report is its owner's: they read and delete it. Colleagues they share
     it with only read it. Administrators read and delete every report; none
     but the owner refreshes or shares, which the model checks itself. -->
<odoo>
    <record id="ai_report_rule_user" model="ir.rule">
        <field name="name">AI report: own and shared with me</field>
        <field name="model_id" ref="model_ai_report"/>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('shared_user_ids', 'in', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="ai_report_rule_owner" model="ir.rule">
        <field name="name">AI report: only the owner changes or deletes</field>
        <field name="model_id" ref="model_ai_report"/>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="ai_report_rule_system" model="ir.rule">
        <field name="name">AI report: administrators review all</field>
        <field name="model_id" ref="model_ai_report"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="ai_report_share_log_rule_user" model="ir.rule">
        <field name="name">AI report share log: of my own reports</field>
        <field name="model_id" ref="model_ai_report_share_log"/>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant'))]"/>
        <field name="domain_force">[('report_id.user_id', '=', user.id)]</field>
    </record>

    <record id="ai_report_share_log_rule_system" model="ir.rule">
        <field name="name">AI report share log: administrators review all</field>
        <field name="model_id" ref="model_ai_report_share_log"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="ai_report_share_rule_user" model="ir.rule">
        <field name="name">Share an AI report: own dialogs</field>
        <field name="model_id" ref="model_ai_report_share"/>
        <field name="groups" eval="[Command.link(ref('group_ai_assistant'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
</odoo>
