<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <!-- An icon on a phone, so the topbar keeps its room. -->
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="this.hasAskAi"
                    class="o-mail-Chatter-askAi btn btn-secondary text-nowrap"
                    type="button"
                    title="Ask AI"
                    t-on-click="this.onClickAskAi">
                <i class="oi d-md-none" data-icon="wand_stars" role="img" aria-label="Ask AI"/>
                <span class="d-none d-md-inline">Ask AI</span>
            </button>
        </xpath>
    </t>

</templates>
