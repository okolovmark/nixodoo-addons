<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_assistant.AiAssistantApp">
        <div class="o_action o_action_delegate_scroll o_ai_assistant_app">
            <Layout display="{ controlPanel: {} }" className="'d-flex bg-view'">
                <t t-set-slot="control-panel-buttons">
                    <button class="o_ai_assistant_new_chat btn btn-primary" type="button" t-on-click="this.newChat">New chat</button>
                </t>
                <aside class="o_ai_assistant_sidebar col-12 col-md-4 col-xl-3 flex-column h-100 border-end d-md-flex"
                       t-att-class="this.state.isListShown ? 'd-flex' : 'd-none'">
                    <div class="list-group list-group-flush border-bottom">
                        <button class="o_ai_assistant_reports list-group-item list-group-item-action d-flex align-items-center"
                                type="button"
                                t-att-class="{ active: this.state.page === 'reports' }"
                                t-on-click="this.openReports">
                            <i class="oi me-2" data-icon="bar_chart" aria-hidden="true"/>My reports
                        </button>
                    </div>
                    <div class="small text-uppercase text-muted fw-bold px-3 pt-3 pb-1">Conversations</div>
                    <div class="o_ai_assistant_conversations list-group list-group-flush flex-grow-1 flex-basis-0 overflow-auto">
                        <div t-foreach="this.state.conversations" t-as="conversation" t-key="conversation.id"
                             class="o_ai_assistant_conversation list-group-item list-group-item-action d-flex align-items-center p-0"
                             t-att-class="{ active: this.state.page === 'chat' and conversation.id === this.state.conversationId }">
                            <button class="o_ai_assistant_conversation_open btn text-reset text-start flex-grow-1 min-w-0 px-3 py-2 border-0 shadow-none"
                                    type="button"
                                    t-on-click="() => this.openConversation(conversation.id)">
                                <div class="text-truncate" t-out="conversation.name"/>
                                <div class="small opacity-75" t-out="this.lastActivity(conversation)"/>
                            </button>
                            <button class="o_ai_assistant_delete btn text-reset opacity-75 border-0 shadow-none me-1"
                                    type="button"
                                    title="Delete conversation"
                                    aria-label="Delete conversation"
                                    t-on-click="() => this.deleteConversation(conversation)">
                                <i class="oi" data-icon="delete" aria-hidden="true"/>
                            </button>
                        </div>
                        <div t-if="!this.state.conversations.length" class="text-muted small px-3 py-2">
                            No conversations yet.
                        </div>
                    </div>
                </aside>
                <section class="o_ai_assistant_main flex-column flex-grow-1 min-w-0 h-100 d-md-flex"
                         t-att-class="this.state.isListShown ? 'd-none' : 'd-flex'">
                    <div class="d-flex align-items-center gap-2 border-bottom px-3 py-2">
                        <button class="o_ai_assistant_back btn btn-link p-0"
                                type="button"
                                t-att-class="{ 'd-md-none': this.state.page !== 'report' }"
                                title="Back"
                                aria-label="Back"
                                t-on-click="this.goBack">
                            <i class="oi" data-icon="arrow_back" aria-hidden="true"/>
                        </button>
                        <span class="o_ai_assistant_title fw-bold text-truncate" t-out="this.title"/>
                    </div>
                    <t t-if="this.state.page === 'reports'">
                        <div t-if="this.state.reports.length" class="o_ai_assistant_report_list list-group list-group-flush flex-grow-1 flex-basis-0 overflow-auto">
                            <div t-foreach="this.state.reports" t-as="report" t-key="report.id"
                                 class="o_ai_assistant_report list-group-item d-flex align-items-center p-0">
                                <button class="o_ai_assistant_report_open btn text-reset text-start flex-grow-1 min-w-0 px-3 py-2 border-0 shadow-none"
                                        type="button"
                                        t-on-click="() => this.openReport(report.id)">
                                    <div class="fw-bold text-truncate" t-out="report.name"/>
                                    <div class="small text-muted text-truncate">
                                        <span t-if="!report.is_owner" class="me-2">Shared by <t t-out="report.owner_name"/></span>
                                        <span t-elif="report.shared_count" class="me-2">Shared with <t t-out="report.shared_count"/></span>
                                        <span>Data of <t t-out="this.formatDate(report.data_date)"/></span>
                                    </div>
                                </button>
                                <Dropdown position="'bottom-end'">
                                    <button class="o_ai_assistant_report_actions btn btn-link text-muted px-3" title="Report actions" aria-label="Report actions">
                                        <i class="oi" data-icon="more_vert" aria-hidden="true"/>
                                    </button>
                                    <t t-set-slot="content">
                                        <DropdownItem onSelected="() => this.openReport(report.id)">Open</DropdownItem>
                                        <DropdownItem t-if="report.can_refresh" onSelected="() => this.refreshReport(report)">Refresh</DropdownItem>
                                        <DropdownItem t-if="report.can_share" onSelected="() => this.shareReport(report)">Share</DropdownItem>
                                        <DropdownItem onSelected="() => this.reportActions.exportXlsx(report.id)">Export to Excel</DropdownItem>
                                        <DropdownItem t-if="report.can_delete" onSelected="() => this.deleteReport(report)">Delete</DropdownItem>
                                    </t>
                                </Dropdown>
                            </div>
                        </div>
                        <div t-else="" class="o_ai_assistant_reports_empty text-center text-muted p-5">
                            <i class="oi oi-3x mb-3" data-icon="bar_chart" aria-hidden="true"/>
                            <p class="fw-bold mb-1">No AI reports yet</p>
                            <p class="small mb-0">Ask the AI Assistant for a report, a chart or a table: what it builds for you, and what colleagues share with you, is listed here.</p>
                        </div>
                    </t>
                    <AiReportView t-elif="this.state.page === 'report'"
                                  reportId="this.state.reportId"
                                  onLoaded.bind="this.onReportLoaded"
                                  onChanged.bind="this.loadReports"
                                  onDeleted.bind="this.onReportDeleted"/>
                    <AiAssistantThread t-else=""
                                       conversationId="this.state.conversationId"
                                       onAsked.bind="this.onAsked"
                                       onOpenReport.bind="this.openReport"/>
                </section>
            </Layout>
        </div>
    </t>

</templates>
