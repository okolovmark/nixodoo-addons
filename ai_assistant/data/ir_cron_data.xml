<?xml version="1.0" encoding="utf-8"?>
<!-- numbercall -1: Odoo 16's default is 1, which runs a cron once and then
     switches it off. -->
<odoo noupdate="1">
    <record id="cron_close_stale_answers" model="ir.cron">
        <field name="name">AI Assistant: close questions whose answer never came</field>
        <field name="model_id" ref="model_ai_assistant_exchange"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_stale()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_claude_incident_watch" model="ir.cron">
        <field name="name">AI Assistant: watch for Claude going quiet</field>
        <field name="model_id" ref="model_ai_assistant_exchange"/>
        <field name="state">code</field>
        <field name="code">model._claude_incident_watch()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_weekly_digest" model="ir.cron">
        <field name="name">AI Assistant: weekly digest of answers to review</field>
        <field name="model_id" ref="model_ai_assistant_exchange"/>
        <field name="state">code</field>
        <field name="code">model._cron_weekly_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
