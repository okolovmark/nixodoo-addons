<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_task_view_form_inherit_member_access" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.project_member_access</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_ai_driven.view_task_form2_common" />
        <field name="arch" type="xml">
            <!-- the domains of the fields, with the members of a Private project only -->
            <xpath expr="//sheet//field[@name='user_ids'][not(ancestor::field)]" position="attributes">
                <attribute name="readonly">not is_assignee_change_allowed</attribute>
                <attribute
                    name="domain"
                >['|', ('share', '=', False), ('id', 'in', project_sharing_portal_user_ids), ('active', '=', True), '|', ('company_id', '=?', company_id), ('company_ids', 'in', company_id)] + ([('id', 'in', project_member_user_ids)] if project_access_mode == 'private' else [])</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='uat_user_ids'][not(ancestor::field)]" position="attributes">
                <attribute name="readonly">not is_uat_user_change_allowed</attribute>
                <attribute
                    name="domain"
                >[('share', '=', False), ('active', '=', True), '|', ('company_id', '=?', company_id), ('company_ids', 'in', company_id)] + ([('id', 'in', project_member_user_ids)] if project_access_mode == 'private' else [])</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_card_inherit_member_access" model="ir.ui.view">
        <field name="name">project.task.view.card.inherit.project_member_access</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_privacy_visibility']" position="after">
                <field name="project_access_mode" />
            </xpath>
            <xpath expr="//a[@name='%(project.portal_share_action)d']" position="attributes">
                <attribute name="t-if" add="record.project_access_mode.raw_value == 'standard'" separator="and" />
            </xpath>
        </field>
    </record>
</odoo>
