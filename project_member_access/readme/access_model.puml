@startuml access_model
' Data model and record rules of project_member_access.
' Preview: Alt+D (PlantUML extension)

hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Helvetica

class "project.project" as Project {
  access_mode : standard | public | private
  member_ids : One2many
  .. stored, computed from member_ids ..
  member_user_ids : reader and above
  contributor_user_ids : contributor and above
  editor_user_ids : editor and above
  admin_user_ids : admin
}
class "project.member" as Member {
  {field} project_id : Many2one (cascade)
  {field} user_id : Many2one (internal user)
  role : reader | contributor | editor | admin
  {field} unique(project_id, user_id)
}
class "res.users" as User {
  _project_member_access_domain(model, operation, grant)
}
class "project.task" as Task {
  create_uid
  user_ids : Assignees
  uat_user_ids : UAT users
}
class "checklist item / question row / test case" as Line {
  task_id
  project_id
}
class "project.pull.request" as PullRequest {
  task_ids : Many2many
}
class "Task Analysis / burndown / milestone / update" as ProjectRecord {
  project_id
}

Project "1" *-- "*" Member : member_ids
Member "*" --> "1" User : user_id
Project ..> User : role user sets
Task "*" --> "0..1" Project : project_id
Line "*" --> "1" Task : task_id
PullRequest "*" -- "*" Task : task_ids
ProjectRecord "*" --> "1" Project : project_id

note as Rules
  <b>Per model and operation</b>
  global rule:  outside OR allow
  internal users rule:  inside AND allow
  (where another module's group rule could still deny)

  outside = Standard project, or no project
  inside  = Public or Private project

  <b>allow</b>, for the current user
  read: Public, or member (Project Administrator: any)
  task create: readable and contributor_user_ids
  task write, lines: readable and (own task or editor_user_ids)
    own task = its creator, an assignee or a UAT user
  task unlink: readable and admin_user_ids
  project, milestone, update writes: admin_user_ids
  member rows: admin_user_ids (Standard: Project Administrator too)
  Settings administrator: all; portal user: none

  <b>Checked in create / write</b>
  assignees: Admin; stage: assignee, Editor or Admin
  task moving in: Contributor (with assignees: Admin)
  stages of the project: Admin
  member rows: added by an Admin, last Admin kept
end note
Rules .. User
@enduml
