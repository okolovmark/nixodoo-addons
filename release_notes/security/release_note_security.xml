<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="release_note_rule_user" model="ir.rule">
        <field name="name">Release Note: internal users see published notes</field>
        <field name="model_id" ref="model_release_note"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="release_note_rule_manager" model="ir.rule">
        <field name="name">Release Note: managers see all notes</field>
        <field name="model_id" ref="model_release_note"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_release_note_manager'))]"/>
    </record>
</odoo>
