<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="release_notes.Announcement">
        <div t-if="this.releaseNotes.count()" class="o_release_notes_announcement w-100 px-3 pt-3">
            <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-0" role="status">
                <span class="flex-grow-1">
                    <i class="fa fa-bullhorn me-2" role="img" aria-label="New updates" title="New updates"/>
                    <t t-if="this.releaseNotes.count() === 1">New in Odoo: </t>
                    <t t-else=""><t t-out="this.releaseNotes.count()"/> new updates in Odoo. Newest: </t>
                    <b t-out="this.releaseNotes.title()"/>
                </span>
                <span class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm o_release_notes_view"
                            t-on-click.stop="this.onView">View</button>
                    <button type="button" class="btn btn-link btn-sm o_release_notes_skip"
                            t-on-click.stop="this.onSkip">Skip</button>
                </span>
            </div>
        </div>
    </t>

    <t t-name="release_notes.Counter">
        <span t-if="this.releaseNotes.count()" class="o_release_notes_counter badge rounded-pill bg-danger ms-1"
              title="New updates in Odoo" t-out="this.releaseNotes.count()"/>
    </t>

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//i[@data-icon='apps']" position="after">
            <ReleaseNotesCounter/>
        </xpath>
        <xpath expr="//DropdownItem" position="before">
            <ReleaseNotesAnnouncement/>
        </xpath>
    </t>

    <!-- the phone's apps menu: a sidebar behind the burger icon -->
    <t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension">
        <xpath expr="//i[@data-icon='menu']" position="after">
            <ReleaseNotesCounter/>
        </xpath>
        <xpath expr="//nav[hasclass('o_burger_menu_content')]" position="before">
            <ReleaseNotesAnnouncement onView="() => this._closeAppMenuSidebar()"/>
        </xpath>
    </t>
</templates>
