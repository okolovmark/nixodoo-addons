<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="release_note_tag_view_list" model="ir.ui.view">
        <field name="name">release.note.tag.view.list</field>
        <field name="model">release.note.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="release_note_tag_action" model="ir.actions.act_window">
        <field name="name">Release Note Tags</field>
        <field name="res_model">release.note.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
