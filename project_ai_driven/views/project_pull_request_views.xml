<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_pull_request_view_form" model="ir.ui.view">
        <field name="name">project.pull.request.view.form</field>
        <field name="model">project.pull.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url" />
                            <field name="repository" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="merge_date" />
                            <field name="deploy_date" />
                        </group>
                    </group>
                    <group string="Tasks">
                        <field name="task_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="name" />
                                <field name="project_id" />
                                <field name="stage_id" />
                                <field name="resolution" />
                            </list>
                            <kanban class="o_kanban_mobile">
                                <templates>
                                    <t t-name="card">
                                        <field name="name" class="fw-bolder" />
                                        <footer>
                                            <field name="project_id" class="text-muted" />
                                            <field name="stage_id" class="ms-auto" />
                                        </footer>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_pull_request_view_tree" model="ir.ui.view">
        <field name="name">project.pull.request.view.tree</field>
        <field name="model">project.pull.request</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="display_name" string="Pull Request" />
                <field name="url" widget="url" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'open'"
                    decoration-success="state == 'merged'"
                />
                <field name="merge_date" />
                <field name="deploy_date" />
                <field name="task_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="project_pull_request_view_kanban" model="ir.ui.view">
        <field name="name">project.pull.request.view.kanban</field>
        <field name="model">project.pull.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="id desc">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-2">
                            <field name="display_name" class="fw-bolder text-break" />
                            <field
                                name="state"
                                widget="badge"
                                class="ms-auto flex-shrink-0"
                                decoration-info="state == 'open'"
                                decoration-success="state == 'merged'"
                            />
                        </div>
                        <field name="url" widget="url" class="text-break" />
                        <footer class="text-muted">
                            <span t-if="record.merge_date.raw_value">
                                Merged <field name="merge_date" />
                            </span>
                            <span t-if="record.deploy_date.raw_value" class="ms-auto">
                                Deployed <field name="deploy_date" />
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_pull_request_view_search" model="ir.ui.view">
        <field name="name">project.pull.request.view.search</field>
        <field name="model">project.pull.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="url" />
                <field name="repository" />
                <field name="task_ids" />
                <filter string="Open" name="open" domain="[('state', '=', 'open')]" />
                <filter string="Merged" name="merged" domain="[('state', '=', 'merged')]" />
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]" />
                <filter string="No State" name="no_state" domain="[('state', '=', False)]" />
                <group>
                    <filter string="Repository" name="group_by_repository" context="{'group_by': 'repository'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_pull_request_action" model="ir.actions.act_window">
        <field name="name">Pull Requests</field>
        <field name="res_model">project.pull.request</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem
        name="Pull Requests"
        parent="project.menu_main_pm"
        id="project_pull_request_menu"
        action="project_pull_request_action"
    />
</odoo>
