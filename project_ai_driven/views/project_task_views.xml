<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_common" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <!-- Above the default (16): applied after the views that add the Checklist and Test Cases pages,
             which this one places its own next to, whatever the ids of the three -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='checklist']" position="after">
                <page
                    name="technical_solution"
                    string="Technical Solution"
                    invisible="not is_ai_driven"
                    groups="project.group_project_user"
                >
                    <group>
                        <field
                            name="questions"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                        <field
                            name="answers"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                        <field
                            name="solution"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='test_cases']" position="after">
                <page name="pull_requests" string="Pull Requests" invisible="not is_ai_driven">
                    <group invisible="not pr_legacy">
                        <field name="pr_legacy" class="text-break" />
                    </group>
                    <field name="pull_request_ids" mode="list,kanban">
                        <list>
                            <field name="url" widget="url" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'open'"
                                decoration-success="state == 'merged'"
                            />
                            <field name="merge_date" />
                            <field name="deploy_date" />
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="priority_level" string="Priority" />
                <field name="tshirt_estimate" string="T-shirt Estimate" />
                <field name="task_type" string="Task Type" />
                <field name="difficulty" />
                <field name="knowledge_area_level" />
                <field name="resolution" invisible="not is_ai_driven" />
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.inherit.view.tree</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="task_type" string="Task Type" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
