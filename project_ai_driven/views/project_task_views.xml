<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_common" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="is_ai_driven" invisible="1" />
            </xpath>
            <xpath expr="//page[2]" position="after">
                <page
                    string="Technical Solution"
                    attrs="{'invisible': [('is_ai_driven', '=', False)]}"
                    groups="project.group_project_user"
                >
                    <group>
                        <field
                            name="questions"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                        <field
                            name="answers"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                        <field
                            name="solution"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='extra_info']" position="before">
                <page
                    string="Pull Requests"
                    name="pull_requests"
                    attrs="{'invisible': [('is_ai_driven', '=', False)]}"
                >
                    <group attrs="{'invisible': [('pr_legacy', '=', False)]}">
                        <field name="pr_legacy" class="text-break" />
                    </group>
                    <field name="pull_request_ids" mode="tree,kanban">
                        <tree>
                            <field name="url" widget="url" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'open'"
                                decoration-success="state == 'merged'"
                            />
                            <field name="merge_date" />
                            <field name="deploy_date" />
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="priority_level" string="Priority" />
                <field name="planned_hours" string="Estimate" widget="float_time" />
                <field name="tshirt_estimate" />
                <field name="task_type" string="Task Type" />
                <field name="resolution" attrs="{'invisible': [('is_ai_driven', '=', False)]}" />
            </xpath>
            <!-- the star of the form itself, wherever in the sheet another module puts it -->
            <xpath expr="//sheet//field[@name='priority'][not(ancestor::field)]" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/tree/field[@name='priority']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/tree/field[@name='priority']" position="after">
                <field name="is_ai_driven" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='depend_on_ids']/tree/field[@name='priority']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='depend_on_ids']/tree/field[@name='priority']" position="after">
                <field name="is_ai_driven" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.inherit.view.tree</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="task_type" string="Task Type" optional="show" />
            </xpath>
            <xpath expr="//tree/field[@name='priority']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='priority']" position="after">
                <field name="is_ai_driven" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="project_task_view_kanban_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.task.view.kanban.inherit.project_ai_driven</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='priority']" position="after">
                <field name="is_ai_driven" />
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]/field[@name='priority']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_calendar_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.task.view.calendar.inherit.project_ai_driven</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_calendar" />
        <field name="arch" type="xml">
            <xpath expr="//calendar/field[@name='priority']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_ai_driven', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//calendar/field[@name='priority']" position="after">
                <field name="is_ai_driven" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
