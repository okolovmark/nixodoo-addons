<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_common" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <!-- Above the default (16): applied after the views that add the Checklist and Test Cases pages,
             which this one places its own next to, whatever the ids of the three -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='checklist']" position="after">
                <page
                    name="technical_solution"
                    string="Technical Solution"
                    invisible="not is_ai_driven"
                    groups="project.group_project_user"
                >
                    <separator string="Questions" />
                    <field name="question_ids" mode="list,kanban">
                        <list decoration-muted="state == 'dropped'">
                            <field name="sequence" widget="handle" />
                            <field name="round" optional="show" />
                            <field name="question" />
                            <field name="answer" optional="hide" />
                            <field name="addressed_to_id" widget="many2one_avatar_user" optional="show" />
                            <field
                                name="state"
                                width="100px"
                                widget="badge"
                                decoration-info="state == 'open'"
                                decoration-success="state == 'answered'"
                                decoration-muted="state == 'dropped'"
                            />
                            <field name="answered_by_id" widget="many2one_avatar_user" optional="show" />
                            <field name="answered_on" optional="show" />
                        </list>
                        <!-- the phone gets cards: the list does not fit its width -->
                        <kanban class="o_kanban_mobile">
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <field name="round" class="text-muted small text-break" />
                                        <field
                                            name="state"
                                            widget="badge"
                                            class="ms-auto flex-shrink-0"
                                            decoration-info="state == 'open'"
                                            decoration-success="state == 'answered'"
                                            decoration-muted="state == 'dropped'"
                                        />
                                    </div>
                                    <field name="question" />
                                    <div t-if="record.addressed_to_id.raw_value" class="text-muted small">
                                        Addressed to <field name="addressed_to_id" />
                                    </div>
                                    <div
                                        t-if="record.answered_by_id.raw_value and record.answered_on.raw_value"
                                        class="text-muted small"
                                    >
                                        <field name="answered_by_id" /> - <field name="answered_on" />
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form>
                            <group>
                                <group>
                                    <field name="round" placeholder="A name or a date" />
                                    <field name="addressed_to_id" />
                                </group>
                                <group>
                                    <!-- a new row is Open, or Answered once it is given an answer -->
                                    <field
                                        name="state"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                        readonly="not id"
                                    />
                                    <field name="answered_by_id" readonly="1" />
                                    <field name="answered_on" readonly="1" />
                                </group>
                            </group>
                            <group>
                                <field name="question" class="o_field_html_autogrow" />
                                <field name="answer" class="o_field_html_autogrow" />
                            </group>
                        </form>
                    </field>
                    <group>
                        <field
                            name="solution"
                            placeholder="Add a description..."
                            class="o_field_html_autogrow"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='test_cases']" position="after">
                <page name="pull_requests" string="Pull Requests" invisible="not is_ai_driven">
                    <group invisible="not pr_legacy">
                        <field name="pr_legacy" class="text-break" />
                    </group>
                    <field name="pull_request_ids" mode="list,kanban">
                        <list>
                            <field name="url" widget="url" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'open'"
                                decoration-success="state == 'merged'"
                            />
                            <field name="merge_date" />
                            <field name="deploy_date" />
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="priority_level" string="Priority" />
                <field name="allocated_hours" string="Estimate" widget="float_time" />
                <field name="tshirt_estimate" />
                <field name="task_type" string="Task Type" />
                <field name="resolution" invisible="not is_ai_driven" />
            </xpath>
            <!-- the two stars of the form itself, wherever in the sheet another module puts them -->
            <xpath expr="//sheet//field[@name='priority'][not(ancestor::field)]" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
            <xpath expr="(//sheet//field[@name='priority'][not(ancestor::field)])[2]" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
            <!-- row by row: a sub-task or a blocking task may belong to another project -->
            <xpath expr="//field[@name='child_ids']/list/field[@name='priority']" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
            <xpath expr="//field[@name='depend_on_ids']/list/field[@name='priority']" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.inherit.view.tree</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="task_type" string="Task Type" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="project_task_view_tree_base_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.task.view.list.base.inherit.project_ai_driven</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_base" />
        <field name="arch" type="xml">
            <!-- the column for the list of a flagged project, the rows for a list that mixes projects -->
            <xpath expr="//list/field[@name='priority']" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
                <attribute name="column_invisible">context.get('ai_driven')</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_card_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.task.view.card.inherit.project_ai_driven</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <xpath expr="//footer/field[@name='priority']" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_calendar_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.task.view.calendar.inherit.project_ai_driven</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_calendar" />
        <field name="arch" type="xml">
            <xpath expr="//calendar/field[@name='priority']" position="attributes">
                <attribute name="invisible">is_ai_driven</attribute>
            </xpath>
        </field>
    </record>
</odoo>
