<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_project_view_form_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='partner_id']" position="before">
                <label for="key" class="d-md-none" />
                <div class="d-flex align-items-baseline">
                    <i class="d-none d-md-inline oi oi-fw me-2" data-icon="key" title="Key" />
                    <field name="key" nolabel="1" required="1" placeholder="Key, e.g. PROJ" />
                </div>
            </xpath>
            <xpath expr="//group[@name='group_tasks_managment']" position="inside">
                <setting
                    class="col-lg-12"
                    id="ai_driven_project_setting"
                    help="Show the Technical Solution and Pull Requests tabs and the Resolution on the tasks of this project, and hide the priority star on them"
                >
                    <field name="is_ai_driven" />
                </setting>
                <setting
                    class="col-lg-12"
                    id="develops_this_odoo_setting"
                    help="The tasks of this project change this Odoo database: their form shows the installed modules they touch. One project at most carries it"
                    invisible="not is_ai_driven and not develops_this_odoo"
                    groups="base.group_system"
                >
                    <field name="develops_this_odoo" />
                </setting>
                <setting
                    class="col-lg-12"
                    id="pr_required_states_setting"
                    help="A task enters these stages only with a Resolution, and with a pull request when the Resolution is Code"
                    invisible="not is_ai_driven"
                >
                    <field
                        name="pr_required_states"
                        widget="many2many_tags"
                        domain="[('project_ids', '=', id)]"
                        options="{'no_create': True}"
                    />
                </setting>
                <setting
                    class="col-lg-12"
                    id="estimate_required_states_setting"
                    help="A task enters these stages only with a task type and an estimate above zero hours"
                    invisible="not is_ai_driven"
                >
                    <field
                        name="estimate_required_states"
                        widget="many2many_tags"
                        domain="[('project_ids', '=', id)]"
                        options="{'no_create': True}"
                    />
                </setting>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_tree_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.list.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="key" readonly="1" />
            </xpath>
        </field>
    </record>
    <record id="project_project_view_form_simplified_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='alias_def']" position="after">
                <field name="key" />
            </xpath>
        </field>
    </record>
    <record id="project_project_view_card_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.card.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_card" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']//field[@name='display_name']" position="before">
                <t t-if="record.key.raw_value"><field name="key" /> - </t>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_search_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.search.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('key', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
