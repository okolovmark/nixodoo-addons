<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_project_view_form_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_tasks_managment']" position="inside">
                <setting
                    class="col-lg-12"
                    id="ai_driven_project_setting"
                    help="Show the Technical Solution tab on the tasks of this project"
                >
                    <field name="is_ai_driven" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
