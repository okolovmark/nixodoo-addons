<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_project_view_form_inherit_ai_driven" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project_ai_driven</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_tasks_managment']" position="inside">
                <setting
                    class="col-lg-12"
                    id="ai_driven_project_setting"
                    help="Show the Technical Solution and Pull Requests tabs and the Resolution on the tasks of this project"
                >
                    <field name="is_ai_driven" />
                </setting>
                <setting
                    class="col-lg-12"
                    id="pr_required_states_setting"
                    help="A task enters these stages only with a Resolution, and with a pull request when the Resolution is Code"
                    invisible="not is_ai_driven"
                >
                    <field
                        name="pr_required_states"
                        widget="many2many_tags"
                        domain="[('project_ids', '=', id)]"
                        options="{'no_create': True}"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
