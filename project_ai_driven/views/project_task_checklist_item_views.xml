<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <!-- After Description, which stays the tab a task opens on, as in core.
                 The Technical Solution and Test Cases pages anchor on this one. -->
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="checklist" string="Checklist" groups="project.group_project_user">
                    <field name="checklist_item_ids">
                        <list
                            editable="bottom"
                            decoration-danger="recolor"
                            decoration-muted="state == 'cancelled'"
                            decoration-success="state == 'done'"
                            decoration-info="state == 'waiting'"
                        >
                            <field name="name" />
                            <field name="user_id" />
                            <field name="state" readonly="True" />
                            <button
                                name="change_state_done"
                                title="Change state to DONE"
                                type="object"
                                icon="check"
                                invisible="state in ['done', 'cancelled'] or hide_button"
                            />
                            <button
                                name="change_state_todo"
                                title="Change state to TODO"
                                type="object"
                                icon="arrow_circle_right"
                                invisible="state == 'todo' or hide_button"
                            />
                            <button
                                name="change_state_waiting"
                                type="object"
                                title="Change state to Waiting"
                                icon="pause"
                                invisible="state == 'waiting' or hide_button"
                            />
                            <button
                                name="change_state_cancelled"
                                type="object"
                                title="Change state to CANCELLED"
                                icon="block"
                                invisible="state == 'cancelled' or hide_button"
                            />
                            <field name="reviewer_id" />
                            <field name="deadline" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_task_kanban_checklist" model="ir.ui.view">
        <field name="name">project.task.kanban.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <templates position="before">
                <field name="completion_xml" />
                <field name="kanban_checklist" />
            </templates>
            <xpath expr="//footer" position="before">
                <div>
                    <t t-out="record.completion_xml.raw_value" />
                    <t t-out="record.kanban_checklist.raw_value" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="project_task_checklist_item_view_form" model="ir.ui.view">
        <field name="name">project.task.checklist.item.view.form</field>
        <field name="model">project.task.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="user_id" />
                        <field name="state" />
                        <field name="task_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_task_checklist_item_view_search" model="ir.ui.view">
        <field name="name">project.task.checklist.item.view.search</field>
        <field name="model">project.task.checklist.item</field>
        <field name="arch" type="xml">
            <search string="Filter">
                <field name="name" string="Description" />
                <filter string="My" domain="[('user_id','=',uid)]" name="my" />
                <separator />
                <filter string="TODO" domain="[('state','=','todo')]" name="todo" />
                <group>
                    <filter string="Project" name="project" context="{'group_by':'project_id'}" />
                    <filter string="Task" name="task" context="{'group_by':'task_id'}" />
                    <filter string="User" name="user" context="{'group_by':'user_id'}" />
                    <filter string="Status" name="state" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_task_checklist_item_view_tree" model="ir.ui.view">
        <field name="name">project.task.checklist.item.view.tree</field>
        <field name="model">project.task.checklist.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_id" />
                <field name="state" />
                <field name="reviewer_id" />
                <field name="task_id" />
                <field name="task_state" />
            </list>
        </field>
    </record>

    <record id="action_view_checklist_item" model="ir.actions.act_window">
        <field name="name">Checklist</field>
        <field name="res_model">project.task.checklist.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                'search_default_my': 1,
                'search_default_todo': 1,
            }
        </field>
    </record>

    <menuitem
        name="Checklist"
        parent="project.menu_main_pm"
        id="menu_action_view_checklist_item"
        action="action_view_checklist_item"
    />
</odoo>
