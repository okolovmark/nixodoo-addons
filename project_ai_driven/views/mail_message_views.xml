<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- a priority above the views of mail: they stay the default views of messages -->
    <record id="mail_message_view_tree_task_note" model="ir.ui.view">
        <field name="name">mail.message.view.list.task.note</field>
        <field name="model">mail.message</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" export_xlsx="0" default_order="date desc, id desc">
                <field name="date" />
                <field name="author_id" widget="many2one_avatar" />
                <field name="task_id" />
                <field name="note_category" widget="badge" />
                <field name="preview" />
            </list>
        </field>
    </record>

    <record id="mail_message_view_kanban_task_note" model="ir.ui.view">
        <field name="name">mail.message.view.kanban.task.note</field>
        <field name="model">mail.message</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_mobile"
                create="0"
                delete="0"
                records_draggable="0"
                group_create="0"
                group_edit="0"
                group_delete="0"
                default_order="date desc, id desc"
            >
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-2">
                            <field name="task_id" class="fw-bolder text-break" />
                            <field name="note_category" widget="badge" class="ms-auto flex-shrink-0" />
                        </div>
                        <field name="preview" class="text-break" />
                        <footer class="text-muted">
                            <field name="author_id" />
                            <field name="date" class="ms-auto" />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mail_message_view_form_task_note" model="ir.ui.view">
        <field name="name">mail.message.view.form.task.note</field>
        <field name="model">mail.message</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_document" type="object" string="Open Task" class="oe_highlight" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="task_id" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="note_category" />
                            <field name="author_id" widget="many2one_avatar" />
                        </group>
                        <group>
                            <field name="date" />
                        </group>
                    </group>
                    <field name="body" />
                    <field name="attachment_ids" widget="many2many_binary" invisible="not attachment_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_message_view_search_task_note" model="ir.ui.view">
        <field name="name">mail.message.view.search.task.note</field>
        <field name="model">mail.message</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="body" string="Contents" />
                <field name="task_id" />
                <field name="author_id" />
                <filter
                    string="Requirement Change"
                    name="requirement_change"
                    domain="[('note_category', '=', 'requirement_change')]"
                />
                <filter
                    string="Design Decision"
                    name="design_decision"
                    domain="[('note_category', '=', 'design_decision')]"
                />
                <filter string="Bug Fix" name="bug_fix" domain="[('note_category', '=', 'bug_fix')]" />
                <filter string="Review Fix" name="review_fix" domain="[('note_category', '=', 'review_fix')]" />
                <filter
                    string="User Feedback"
                    name="user_feedback"
                    domain="[('note_category', '=', 'user_feedback')]"
                />
                <filter string="Progress" name="progress" domain="[('note_category', '=', 'progress')]" />
                <filter string="Revised" name="revised" domain="[('note_category', '=', 'revised')]" />
                <filter string="Deploy" name="deploy" domain="[('note_category', '=', 'deploy')]" />
                <group>
                    <filter string="Category" name="group_by_note_category" context="{'group_by': 'note_category'}" />
                    <filter string="Task" name="group_by_task" context="{'group_by': 'task_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_message_action_task_note" model="ir.actions.act_window">
        <field name="name">Task Notes</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list,kanban,form</field>
        <field
            name="domain"
            eval="[
                ('model', '=', 'project.task'),
                ('task_id', 'access', 'read'),
                ('subtype_id', '=', ref('mail.mt_note')),
                ('message_type', 'not in', ['user_notification', 'tracking']),
                '|',
                ('body', 'not in', ['', False]),
                ('attachment_ids', '!=', False),
            ]"
        />
        <field name="search_view_id" ref="mail_message_view_search_task_note" />
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'view_mode': 'list', 'view_id': ref('mail_message_view_tree_task_note')}),
                Command.create({'view_mode': 'kanban', 'view_id': ref('mail_message_view_kanban_task_note')}),
                Command.create({'view_mode': 'form', 'view_id': ref('mail_message_view_form_task_note')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No internal notes of tasks</p>
            <p>The notes logged in the chatter of a task are listed here.</p>
        </field>
    </record>

    <menuitem
        name="Task Notes"
        parent="project.menu_main_pm"
        id="mail_message_menu_task_note"
        action="mail_message_action_task_note"
        groups="project.group_project_user"
    />

    <record id="project_task_view_form_inherit_notes" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.notes</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_notes"
                    type="object"
                    class="oe_stat_button"
                    icon="sticky_note_2"
                    invisible="note_count == 0"
                    groups="project.group_project_user"
                >
                    <field name="note_count" widget="statinfo" string="Notes" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
