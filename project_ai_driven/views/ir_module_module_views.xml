<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The picker of a task's modules: priority 100, after the views of base, which stay the Apps defaults.
         No button and no link: core's Apps kanban upgrades or uninstalls a module from its card. -->
    <record id="ir_module_module_view_tree_task_picker" model="ir.ui.view">
        <field name="name">ir.module.module.view.tree.task.picker</field>
        <field name="model">ir.module.module</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" export_xlsx="0" default_order="name">
                <field name="name" />
                <field name="shortdesc" />
            </tree>
        </field>
    </record>

    <record id="ir_module_module_view_kanban_task_picker" model="ir.ui.view">
        <field name="name">ir.module.module.view.kanban.task.picker</field>
        <field name="model">ir.module.module</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" delete="0" default_order="name">
                <field name="name" />
                <field name="shortdesc" />
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <strong class="o_kanban_record_title text-break">
                                <field name="name" />
                            </strong>
                            <div class="o_kanban_record_body text-muted">
                                <field name="shortdesc" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
